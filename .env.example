# --- Accès (obligatoire) ---
TEAM_CODE=            # code donné aux techniciens
MANAGER_CODE=         # code des LTA / RSC (accès pilotage)
SESSION_SECRET=       # longue chaîne aléatoire
# MANAGER_IDS=        # optionnel : ids forcés manager (ex. sebastien-bachir,eric-barnier)

# --- Base (obligatoire en production) ---
DATABASE_URL=         # Neon : postgres://...

# --- IA (Grok par défaut si la clé est présente) ---
XAI_API_KEY=          # clé Grok : console.x.ai
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AI_PROVIDER=        # grok | claude | gemini (pour forcer)
# AI_MODEL=           # défaut Grok : grok-4-latest

# --- Diffusion du lundi ---
TEAMS_WEBHOOK_URL=    # URL du flux Power Automate
BREVO_API_KEY=
MAIL_FROM=tk.elevator.france@gmail.com
SEND_TIME=08:35
CRON_SECRET=          # pour le réveil externe /api/cron/weekly?key=...
APP_URL=              # ex. https://safetylift.onrender.com (liens dans Teams/mails)

# --- Google ---
GOOGLE_SERVICE_ACCOUNT_JSON=   # JSON du compte de service (ou en base64)
